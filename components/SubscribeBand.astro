---
/**
 * Shared closing-CTA "Subscribe to the newsletter" band.
 *
 * Themable across all N+ static sites. Each consumer wraps this once with
 * the right copy + URL; styling reads from the consumer's CSS variables
 * (--color-surface-*, --color-brand-*, --font-display).
 *
 * Variants:
 *   "band"    — full-width section, dark background, large headline (default; use before footer)
 *   "inline"  — bordered card sized for inline use (drop inside article bodies)
 *   "compact" — single pill button, for hero CTA rows
 */

interface Props {
  /** Substack (or other newsletter) URL. */
  href: string;
  variant?: "band" | "inline" | "compact";
  /** Small eyebrow above the heading. */
  eyebrow?: string;
  /** Headline copy. */
  heading?: string;
  /** Subhead (sentence-length). */
  subhead?: string;
  /** Button label. */
  cta?: string;
  /** Fine-print under the button, defaults to a "Substack / unsubscribe any time" line. */
  fineprint?: string | null;
}

const {
  href,
  variant = "band",
  eyebrow = "Newsletter",
  heading = "Subscribe to the newsletter",
  subhead,
  cta = "Subscribe →",
  fineprint = "Powered by Substack · unsubscribe any time",
} = Astro.props;
---

{
  variant === "band" && (
    <section class="bg-surface-950 text-surface-100">
      <div class="mx-auto max-w-3xl px-6 py-20 text-center md:py-24">
        <p class="text-xs font-semibold tracking-[0.25em] text-brand-300 uppercase">{eyebrow}</p>
        <h2 class="font-display mt-5 text-3xl font-semibold tracking-tight text-white md:text-4xl">
          {heading}
        </h2>
        {subhead && (
          <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-surface-300 md:text-lg">
            {subhead}
          </p>
        )}
        <a
          href={href}
          target="_blank"
          rel="noopener"
          class="mt-8 inline-flex items-center gap-2 rounded-full bg-brand-500 px-7 py-3 text-sm font-semibold text-white no-underline transition-colors hover:bg-brand-400"
        >
          {cta}
        </a>
        {fineprint && <p class="mt-4 text-xs text-surface-400">{fineprint}</p>}
      </div>
    </section>
  )
}

{
  variant === "inline" && (
    <aside class="not-prose my-12 rounded-lg border border-surface-200 bg-surface-50 p-6 md:p-8">
      <p class="text-xs font-semibold tracking-[0.18em] text-brand-600 uppercase">{eyebrow}</p>
      <h3 class="font-display mt-2 text-xl font-semibold text-surface-700 md:text-2xl">
        {heading}
      </h3>
      {subhead && <p class="mt-3 text-sm leading-relaxed text-surface-500">{subhead}</p>}
      <a
        href={href}
        target="_blank"
        rel="noopener"
        class="mt-5 inline-flex items-center gap-2 rounded-md bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white no-underline transition-colors hover:bg-brand-700"
      >
        {cta}
      </a>
    </aside>
  )
}

{
  variant === "compact" && (
    <a
      href={href}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-2 rounded-full bg-brand-500 px-4 py-2 text-sm font-semibold text-white no-underline transition-colors hover:bg-brand-600"
    >
      {cta}
    </a>
  )
}
